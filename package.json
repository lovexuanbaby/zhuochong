{
  "name": "dsh-deskpet",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Minimal DSH Host bridge that runs a Python desktop-pet process over newline-delimited JSON.",
  "type": "module",
  "engines": { "node": ">=20" },
  "os": ["win32"],
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5" },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:host": "node tests/config-smoke.mjs && node tests/agent-status-smoke.mjs && node tests/chat-host-smoke.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config.js",
    "python-runtime.js",
    "cordis.patch.yml",
    "python/*.py",
    "requirements.txt",
    "scripts/setup.ps1",
    "scripts/doctor.ps1",
    "scripts/python-common.ps1",
    "docs/INSTALL.md",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
