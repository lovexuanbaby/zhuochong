{
  "name": "dsh-deskpet",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal DSH Host bridge that runs a Python desktop-pet process over newline-delimited JSON.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "python/*.py",
    "requirements.txt",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
